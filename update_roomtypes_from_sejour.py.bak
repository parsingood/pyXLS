########################################## Odafiy_Roomtype
Pcursor.execute('''
    delete from  Odafiy_Roomtype
'''  )
Pcursor.commit()
Scursor.execute('''
    select t.Turop, t.FiyTuru,t.Otel,null room_code
    , t.Oda+' # '+t.OdaTip + ' #' + o.Tanim +'#'+ p.Tanim room_type
    from Odafiy t
    left join oda o on o.Oda=t.oda
    left join Odatip p on p.OTip=t.OdaTip
    where t.Sezno='S22'
    group by t.Turop,t.Otel, t.Oda,t.OdaTip, t.FiyTuru
    ,o.Tanim, p.Tanim
    order by t.Turop,t.Otel, t.Oda,t.OdaTip, t.FiyTuru 
''' )
Srows = Scursor.fetchall()
for row in Srows:

    Pcursor.execute('''
        insert Odafiy_Roomtype(Turop,FiyTuru,Otel,room_code,room_type)
        select ?,?,?,?,?
    ''' , row.Turop,row.FiyTuru,row.Otel,row.room_code,row.room_type )
